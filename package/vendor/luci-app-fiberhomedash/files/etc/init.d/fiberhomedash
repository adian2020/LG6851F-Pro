#!/bin/sh /etc/rc.common

# fiberhomedash: status dashboard sampler.
#
# The sampler owns every periodic read the dashboard needs, so the LuCI page
# and the rpcd backend stay cheap.  It idles by itself when no page has polled
# for a while, and it runs at a low priority so it can never compete with the
# modem data path.

START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled
	config_load fiberhomedash
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/share/rpcd/ucode/fiberhomedash sample
	procd_set_param respawn 3600 5 5
	procd_set_param nice 10
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

stop_service() {
	rm -f /tmp/fiberhomedash.sampler /tmp/fiberhomedash.live.json
}
